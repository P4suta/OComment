{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocomment.dev/schema/result-v1.json",
  "title": "OComment JSON output v1",
  "oneOf": [
    { "$ref": "#/$defs/envelope" },
    { "$ref": "#/$defs/file" },
    { "$ref": "#/$defs/skip" }
  ],
  "$defs": {
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "files", "skipped"],
      "properties": {
        "version": { "const": 1 },
        "files": { "type": "array", "items": { "$ref": "#/$defs/file" } },
        "skipped": { "type": "array", "items": { "$ref": "#/$defs/skipBody" } }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "language", "changed", "report", "edits"],
      "properties": {
        "path": { "type": "string" },
        "language": { "$ref": "#/$defs/language" },
        "changed": { "type": "boolean" },
        "report": { "$ref": "#/$defs/report" },
        "edits": { "type": "array", "items": { "$ref": "#/$defs/edit" } },
        "source_map": { "$ref": "#/$defs/sourceMap" }
      }
    },
    "skip": {
      "allOf": [
        { "$ref": "#/$defs/skipBody" },
        { "type": "object", "required": ["type"], "properties": { "type": { "const": "skip" } } }
      ]
    },
    "skipBody": {
      "type": "object",
      "required": ["path", "reason", "error"],
      "properties": {
        "type": { "const": "skip" },
        "path": { "type": "string" },
        "reason": { "type": "string" },
        "error": { "type": "boolean" }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "comments", "diagnostics", "valid"],
      "properties": {
        "language": { "$ref": "#/$defs/language" },
        "comments": { "type": "array", "items": { "$ref": "#/$defs/comment" } },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
        "valid": { "type": "boolean" }
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      }
    },
    "comment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["span", "line", "column", "end_line", "end_column", "kind", "disposition"],
      "properties": {
        "established": {
          "const": false,
          "description": "Present, and only ever false, on a comment the scan did not establish. `valid` says whether the lex failed; it cannot say where, and a caller acting on a verdict needs that. A scanner that cannot find the end of a token does not know where the next one starts, so an unterminated block opener is reported as a comment running to the end of the file, and the code under it is not a comment. The verdict is in the report because it is what the scanner concluded; this field is here because acting on it would delete code. `fix --force-invalid` skips exactly these comments."
        },
        "span": { "$ref": "#/$defs/span" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 },
        "end_column": { "type": "integer", "minimum": 1 },
        "kind": { "$ref": "#/$defs/kind" },
        "text": { "type": "string" },
        "explanation": { "$ref": "#/$defs/explanation" },
        "disposition": { "$ref": "#/$defs/disposition" }
      }
    },
    "explanation": {
      "description": "Which rule decided the comment, written by --explain. `rule` is the rule's own name and is the field to match on; `detail` is the same rule as the human report words it and is prose. `setting` names the table and file the setting was written in, and is absent when a built-in rule decided. `next_step` is the flag that would overrule the verdict, when one would.",
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "detail"],
      "properties": {
        "rule": {
          "enum": [
            "kept-by-kind", "kept-by-regex", "kept-by-tag", "kept-directive",
            "kept-documentation", "kept-html", "kept-license",
            "kept-load-bearing", "kept-structural", "protected-preamble",
            "removed-as-expired", "removed-as-trailing", "removed-by-default",
            "removed-by-kind", "removed-by-length", "removed-by-policy",
            "removed-by-regex"
          ]
        },
        "detail": { "type": "string" },
        "setting": { "type": "string" },
        "next_step": { "type": "string" }
      }
    },
    "disposition": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["action"], "properties": { "action": { "const": "remove" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["action", "reason"],
          "properties": { "action": { "const": "keep" }, "reason": { "type": "string" } }
        }
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "severity", "span", "line", "column", "end_line", "end_column"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "severity": { "enum": ["error", "warning", "info", "hint"] },
        "span": { "$ref": "#/$defs/span" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 },
        "end_column": { "type": "integer", "minimum": 1 }
      }
    },
    "edit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["span", "replacement"],
      "properties": {
        "span": { "$ref": "#/$defs/span" },
        "replacement": { "type": "string" }
      }
    },
    "sourceMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segments"],
      "properties": {
        "segments": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceMapSegment" }
        }
      }
    },
    "sourceMapSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original", "output", "exact"],
      "properties": {
        "original": { "$ref": "#/$defs/span" },
        "output": { "$ref": "#/$defs/span" },
        "exact": { "type": "boolean" }
      }
    },
    "language": {
      "enum": ["rust", "ocaml", "c", "cpp", "go", "java", "javascript", "typescript", "python", "shell", "html", "css", "jsonc", "sql", "kotlin", "toml", "lua", "yaml", "php", "ruby", "zig", "r", "dart", "swift", "csharp", "scala", "vue", "svelte", "markdown", "perl", "unknown"]
    },
    "kind": {
      "enum": ["line", "block", "doc-line", "doc-block", "directive", "license", "html-comment", "shebang", "encoding", "optimizer-hint", "version-comment", "load-bearing"]
    }
  }
}
